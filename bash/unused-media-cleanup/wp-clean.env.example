# Copy to /home/ec2-user/.wp-clean.env on the server (not committed).
#
# Safe defaults until Elementor URL detection is fixed:
WP_CLEAN_DRY_RUN=1
WP_CLEAN_EXCLUDE_EXTENSIONS=mp4

WP_CLEAN_BACKUP_DIR=/home/ec2-user/backups/unused-media
WP_CLEAN_BACKUP_RETENTION=1
WP_CLEAN_MIN_AGE_DAYS=7
WP_CLEAN_MAX_PAGES=10
WP_CLEAN_MAX_POSTS=50
WP_CLEAN_PHP_SCRIPT=/home/ec2-user/bin/unused-media-cleanup.php
